<resources>
    <!--
      Android 12+ system splash band nahi ki ja sakti (OS har cold start pe dikhata hai). Isliye use "gayab"
      kar diya: background window ke rang jaisa, icon transparent, animation 0 ms. Dikhta sirf khali bg hai,
      jo seedha app ke pehle frame me badal jaata hai.
    -->
    <style name="Theme.Gallery" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
