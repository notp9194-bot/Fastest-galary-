<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup aur device-to-device transfer, dono me app ka koi data nahi jaata
     (hidden/locked albums, favorites, trash ka prefs yahan se bahar rehta hai). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
